{
	"name": "tabletop",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:spa": "vite build --mode spa",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"e2e:spa": "playwright test --config playwright.spa.config.ts"
	},
	"dependencies": {
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.2",
		"lucide-react": "1.72.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@fontsource-variable/geist": "5.3.0",
		"@playwright/test": "1.65.0",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"jsdom": "31.0.0",
		"shadcn": "4.23.0",
		"sirv-cli": "3.0.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
